# Copy this file to .env and put the key on the next line.
# Create the key at https://console.x.ai — API keys.
# Never commit .env. Prefer: chmod 600 .env
XAI_API_KEY=

# Optional. gRPC host, without a scheme. Use us.api.x.ai to keep inference in the US.
# XAI_API_HOST=api.x.ai

# Optional. Comma-separated collection IDs for Collections Search.
# XAI_COLLECTION_IDS=

# Optional. Path to a JSON file of remote MCP servers. See mcp.example.json.
# CISO_INTEL_MCP_CONFIG=

# Optional overrides. Defaults are the maximum documented settings.
# CISO_INTEL_MODEL=grok-4.7
# CISO_INTEL_REASONING_EFFORT=xhigh
# Suggested lookback when a run is not interactive (--yes, no TTY, or --days omitted).
# A terminal `ciso-intel run` still asks for the time frame. Max 90.
# CISO_INTEL_LOOKBACK_DAYS=14
# CISO_INTEL_TIMEOUT_SECONDS=3600
